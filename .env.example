# Copy this file to .env and fill in private values locally.
# GitHub Pages cannot keep browser-side values secret. Use CHATBOT_API_KEY
# only in a private backend or serverless function.
PORTFOLIO_OWNER_NAME=Alvin
PORTFOLIO_CONTACT_EMAIL=your-email@example.com
PORTFOLIO_WEBSITE_URL=https://arksow.github.io
CHATBOT_API_URL=https://your-private-chatbot-backend.example.com/api/chat
CHATBOT_API_KEY=
